# Экземпляр роя (deploy/swarm): региональные leaf подключаются к хабу центра.
# Адрес центра: другая машина — её IP; центр на этой же машине отдельным проектом — host.docker.internal
HUB_HOST=192.168.1.10
HUB_LEAF_PORT=7422
# Общий пароль leaf-подключений центра (LEAF_PASSWORD в .env центра)
LEAF_USER=leaf
LEAF_PASSWORD=
# Куча роя для run --rm swarm-sim: 250 000 отделений — 4g
SWARM_HEAP=2g
