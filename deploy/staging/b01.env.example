# Branch b01 on staging: cp deploy/staging/b01.env.example deploy/staging/b01.env
# Read after the root .env (--env-file .env --env-file deploy/staging/b01.env). Ports match the local environment, so
# scripts/demo and scripts/chaos run on the staging host unchanged.
BRANCH_ID=b01
BRANCH_NAME="Branch 101000 (b01)"
# Link proxy to the hub inside this project (branch.override.yaml)
CENTER_HOST=center-link
# https://b01.${DOMAIN}
NODE_PORT=8080
DB_PORT=5433
LEAF_CLIENT_PORT=4225
LEAF_MONITOR_PORT=8223
QR_MODE=auto
QR_PUBLIC_BASE_URL=https://${DOMAIN}
QR_LOCAL_BASE_URL=https://b01.${DOMAIN}
