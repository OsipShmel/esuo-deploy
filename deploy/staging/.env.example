# Staging: the center, branches b01 and b02, the load-test regions and the scenario console as separate compose
# projects on one host behind a reverse proxy. See deploy/staging/README.md.
#
# Lives in the repository root: cp deploy/staging/.env.example .env
# Every project reads it (--env-file .env), and so do scripts/demo and scripts/chaos.
# Per-branch id and ports are in deploy/staging/b01.env and b02.env.

# ------------------------------------------------------------------ domain
# Subdomains: the center — DOMAIN, grafana.DOMAIN, prometheus.DOMAIN, b01.DOMAIN, b02.DOMAIN; TCP DOMAIN:7422 — leaf
DOMAIN=staging.example.com

# ------------------------------------------------------------------ secrets (shared by all projects)
# Passwords: openssl rand -hex 24; JWT_SECRET: openssl rand -base64 48
DB_USER=esuo
DB_PASSWORD=
JWT_SECRET=
LEAF_USER=leaf
# Shared leaf account: also used by branches connecting from other machines
LEAF_PASSWORD=
MP_WEBHOOK_SECRET=
QR_SECRET=
# Node <-> scenario console
DEMO_RUNNER_TOKEN=

# ------------------------------------------------------------------ center
CENTER_PUBLIC_URL=https://${DOMAIN}
LEAF_ADVERTISE=${DOMAIN}:7422
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=
# Integrations point at the mocks deployed with the center (center.override.yaml)
NOTIFY_URL=http://notify-mock:8090/notify
MP_CALLBACK_URL=http://mp-simulator:8091/callback
# Sized for load tests with hundreds of thousands of simulated branches; the center container takes about 5 GB
CENTER_HEAP=4g
CENTER_DB_SHARED_BUFFERS=2GB
METRICS_RESOLUTION_REGIONAL=60s
METRICS_MAX_SIZE=30GB

# ------------------------------------------------------------------ branches on this host
NODE_HEAP=1g

# ------------------------------------------------------------------ observability
GRAFANA_PUBLIC_URL=https://grafana.${DOMAIN}
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS=false
GRAFANA_DB_PASSWORD=

# ------------------------------------------------------------------ bind addresses for the reverse proxy
# Proxy on this host — 127.0.0.1; on another machine — 0.0.0.0 plus a firewall that only admits the proxy
CENTER_BIND=127.0.0.1
GRAFANA_BIND=127.0.0.1
PROMETHEUS_BIND=127.0.0.1
NODE_BIND=127.0.0.1
# The hub is reachable from outside: branches on other machines connect to DOMAIN:7422
LEAF_BIND=0.0.0.0

# ------------------------------------------------------------------ demo mode
DEMO_DATA=true
DEMO_MODE=true
# Not operator123 / admin123 on a public address
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
BRANCH_TIMEZONE=Europe/Moscow

# ------------------------------------------------------------------ load test
SWARM_HEAP=4g
