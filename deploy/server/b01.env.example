# Отделение b01 на сервере: cp deploy/server/b01.env.example deploy/server/b01.env
# Читается вторым после .env (--env-file .env --env-file deploy/server/b01.env); порты — как у стенда «всё в одном»,
# поэтому scripts/demo и scripts/chaos работают на сервере без настройки.
BRANCH_ID=b01
BRANCH_NAME=serverb 101000 (b01)
CENTER_HOST=center-link                # кабель связи с хабом в этой же группе (deploy/server/branch.yml)
NODE_PORT=8080                         # → https://b01.${DOMAIN}
DB_PORT=5433
LEAF_CLIENT_PORT=4225
LEAF_MONITOR_PORT=8223
QR_MODE=auto                           # QR на табло: центр, пока есть связь, иначе адрес отделения
QR_PUBLIC_BASE_URL=https://${DOMAIN}
QR_LOCAL_BASE_URL=https://b01.${DOMAIN}