# Отделение b02 на сервере: cp deploy/server/b02.env.example deploy/server/b02.env
# Читается вторым после .env (--env-file .env --env-file deploy/server/b02.env); порты — как у стенда «всё в одном».
BRANCH_ID=b02
BRANCH_NAME=Отделение 102000 (b02)
CENTER_HOST=center-link
NODE_PORT=8090                         # → https://b02.${DOMAIN}
DB_PORT=5434
LEAF_CLIENT_PORT=4226
LEAF_MONITOR_PORT=8224
QR_MODE=auto
QR_PUBLIC_BASE_URL=https://${DOMAIN}
QR_LOCAL_BASE_URL=https://b02.${DOMAIN}
