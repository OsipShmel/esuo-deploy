# Сервер: центр, отделения b01 и b02, рой и пульт сценариев — отдельными группами контейнеров на одном хосте.
# Кладётся в корень репозитория: cp deploy/server/env.example .env
# Его читают все группы (--env-file .env) и скрипты scripts/demo, scripts/chaos (пароли, вход в центр).
# Номер и порты отделения — в deploy/server/b01.env и b02.env. Порядок запуска и маршруты — deploy/server/README.md.

# ------------------------------------------------------------------ домен
# Поддомены: центр — DOMAIN, grafana.DOMAIN, prometheus.DOMAIN, b01.DOMAIN, b02.DOMAIN; TCP DOMAIN:7422 — leaf.
DOMAIN=esuo.example.ru

# ------------------------------------------------------------------ секреты (одни на все группы)
# Сгенерировать: openssl rand -hex 24 (пароли), openssl rand -base64 48 (JWT_SECRET)
DB_USER=esuo
DB_PASSWORD=d0700ef000c01a810a832a36735d0550c3fd42b899912e13
JWT_SECRET=RTzCl8xexhBSG0gCBmcA81HMHK5v8NGg2rPpCyEFJKkDdn
LEAF_USER=leaf
LEAF_PASSWORD=ddc4ab4cb6ed2464245e75cfadeca4363e3f4357fe8e0748                         # общий логин leaf: им же подключаются отделения с ноутбуков
MP_WEBHOOK_SECRET=1077d8b9bbcbf63482b8bc85421128d46f71f43c3d006879
QR_SECRET=9c7e4308827809b96836b91880e8aa208c444ef962ad962a                             # подпись QR-кодов в зале
DEMO_RUNNER_TOKEN=3b2d1c1da3460386dcfeecb46a8c13800a5ba3e53b50824d                     # узел ↔ пульт сценариев

# ------------------------------------------------------------------ центр
CENTER_PUBLIC_URL=https://${DOMAIN}
LEAF_ADVERTISE=${DOMAIN}:7422          # адрес хаба, который хаб сообщает leaf-узлам
CENTER_ADMIN_LOGIN=network             # вход в /network и закрытый API центра
CENTER_ADMIN_PASSWORD=hoola-hoop
CENTER_HEAP=4g                         # куча JVM центра; контейнер займёт ~5 ГБ
CENTER_DB_SHARED_BUFFERS=2GB           # память PostgreSQL центра под таблицы сети: ~четверть ОЗУ, отданного центру
METRICS_RESOLUTION_REGIONAL=60s        # точка метрик у отделений роя
METRICS_MAX_SIZE=30GB                  # потолок истории метрик отделений на диске (по умолчанию 100GB)

# ------------------------------------------------------------------ отделения на сервере
NODE_HEAP=1g                           # куча JVM узла b01 и b02

# ------------------------------------------------------------------ мониторинг
GRAFANA_PUBLIC_URL=https://grafana.${DOMAIN}
GRAFANA_ADMIN_PASSWORD=grafana
GRAFANA_ANONYMOUS=false                # без входа Grafana на публичном адресе не открывается
GRAFANA_DB_PASSWORD=grafana                   # роль grafana_ro: Grafana читает метрики отделений из базы центра

# ------------------------------------------------------------------ куда слушают порты для внешнего прокси
# Прокси на этом же хосте — 127.0.0.1; на другой машине — 0.0.0.0, и тогда порты закрыть фаерволом для всех, кроме прокси.
CENTER_BIND=127.0.0.1                  # центр        :8081
GRAFANA_BIND=127.0.0.1                 # Grafana      :3000
PROMETHEUS_BIND=127.0.0.1              # Prometheus   :9090
NODE_BIND=127.0.0.1                    # отделения    :8080 (b01), :8090 (b02)
LEAF_BIND=0.0.0.0                      # хаб NATS     :7422 — открыт наружу: отделения с ноутбуков

# ------------------------------------------------------------------ демо-стенд
DEMO_DATA=true                         # демо-справочники и пользователи отделений
DEMO_MODE=true                         # демо-часы: сценарии и пульт проигрывают день за минуты
DEMO_OPERATOR_PASSWORD=black-island                # на публичном адресе — не operator123
DEMO_ADMIN_PASSWORD=rolling-waves                   # на публичном адресе — не admin123
BRANCH_TIMEZONE=Europe/Moscow

# ------------------------------------------------------------------ рой
SWARM_HEAP=4g                          # куча роя
