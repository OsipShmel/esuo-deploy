# ESUO network center (deploy/center/compose.yaml). Copy to deploy/center/.env and fill in.

# ------------------------------------------------------------------ secrets
DB_USER=esuo
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# Shared secret for mobile-app webhooks and callbacks (HMAC): openssl rand -base64 32
MP_WEBHOOK_SECRET=
# Leaf accounts: the shared "leaf" login for branches and regional hubs; branch-b01/branch-b02 have their own
# passwords (empty => the shared one)
LEAF_USER=leaf
LEAF_PASSWORD=
LEAF_B01_PASSWORD=
LEAF_B02_PASSWORD=

# ------------------------------------------------------------------ addresses
# What the hub tells leaf nodes to connect to, and what branches put in CENTER_HOST
LEAF_ADVERTISE=center.example.com:7422
# Public URL of the center (links in notifications, QR codes, mobile-app callbacks)
CENTER_PUBLIC_URL=https://center.example.com
# The API listens on loopback for a reverse proxy on this host; 0.0.0.0 if the proxy runs elsewhere
CENTER_BIND=127.0.0.1
CENTER_PORT=8081
LEAF_BIND=0.0.0.0

# ------------------------------------------------------------------ integrations
NOTIFY_URL=https://notify.example.com/notify
MP_CALLBACK_URL=https://mobile-api.example.com/esuo/callback

# ------------------------------------------------------------------ network operator
# Login for /network and the private API; an empty password closes the private API to everyone
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=

# ------------------------------------------------------------------ sizing
# Defaults fit a few thousand branches. For hundreds of thousands (regional hubs):
# CENTER_HEAP=4g
# CENTER_DB_SHARED_BUFFERS=2GB        # about a quarter of the RAM given to the center
# HUB_MEMORY=4g
# HUB_GOMEMLIMIT=3GiB
# METRICS_MAX_SIZE=100GB              # disk cap for branch metrics history

# ------------------------------------------------------------------ observability (--profile monitoring)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS=false
GRAFANA_PUBLIC_URL=https://grafana.center.example.com
# GRAFANA_BIND=127.0.0.1
# Password of the read-only role grafana_ro that Grafana uses for branch metrics: openssl rand -hex 24
GRAFANA_DB_PASSWORD=

# Images: pulled from IMAGE_REGISTRY, or built locally with `up --build`
# IMAGE_REGISTRY=registry.example.com/esuo
# IMAGE_TAG=1.0.0
