# Сервер центра (deploy/center). Имена переменных — те же, что в корневом .env.
DB_USER=esuo
DB_PASSWORD=
# openssl rand -base64 32
JWT_SECRET=
MP_WEBHOOK_SECRET=
# Пароль leaf-подключений: общий логин leaf — для отделений и регионов роя; branch-b01/branch-b02 — свои пароли (пусто — общий)
LEAF_USER=leaf
LEAF_PASSWORD=
LEAF_B01_PASSWORD=
LEAF_B02_PASSWORD=
# Адрес этой машины для отделений: они подключаются к нему (CENTER_HOST в их .env)
LEAF_ADVERTISE=192.168.1.10:7422
CENTER_PUBLIC_URL=http://192.168.1.10:8081
CENTER_PORT=8081
# Оператор сети: вход в /network и закрытый API центра; пусто — закрытый API недоступен никому
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=
# Под рой сотен тысяч отделений: куча центра, память Postgres центра, память хаба NATS
# CENTER_HEAP=4g
# CENTER_DB_SHARED_BUFFERS=2GB
# HUB_MEMORY=4g
# HUB_GOMEMLIMIT=3GiB
# Мониторинг (--profile monitoring): Grafana — вход admin / GRAFANA_ADMIN_PASSWORD; анонимный просмотр только для закрытой сети
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS=false
GRAFANA_PUBLIC_URL=http://192.168.1.10:3000
# Открыть Grafana наружу (по умолчанию только localhost сервера)
# GRAFANA_BIND=0.0.0.0
# Роль grafana_ro (только чтение метрик и аномалий) для панелей Grafana; openssl rand -base64 24
GRAFANA_DB_PASSWORD=
