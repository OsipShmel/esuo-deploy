CENTER_DB_PASSWORD=
# openssl rand -base64 32
CENTER_JWT_SECRET=
LEAF_SHARED_USER=leaf
LEAF_SHARED_PASSWORD=
LEAF_B01_PASSWORD=
LEAF_B02_PASSWORD=
CENTER_PORT=8081
# IP этой машины в локальной сети (отделения подключаются к нему: CENTER_HOST указывается в их .env)
LEAF_ADVERTISE=192.168.1.10:7422
MP_WEBHOOK_SECRET=
CENTER_PUBLIC_URL=http://192.168.1.10:8081
# Оператор сети: вход в /network и закрытый API центра; пусто — закрытый API недоступен никому
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=
# Мониторинг (--profile monitoring): Grafana — вход admin / GRAFANA_ADMIN_PASSWORD; анонимный просмотр только для закрытой сети
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS=false
GRAFANA_PUBLIC_URL=http://192.168.1.10:3000
