# ESUO branch site (deploy/branch/compose.yaml). Copy to deploy/branch/.env and fill in.

# ------------------------------------------------------------------ identity and center link
BRANCH_ID=b01
BRANCH_NAME=Branch 101000
# Host name of the center's NATS hub (its LEAF_ADVERTISE); the branch connects out to it, nothing is opened inbound
CENTER_HOST=center.example.com
CENTER_LEAF_PORT=7422
# Leaf credentials issued by the center: the shared "leaf" account or a per-branch one ("branch-b01")
LEAF_USER=leaf
LEAF_PASSWORD=

# ------------------------------------------------------------------ secrets (local to this branch)
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# QR signing key, required unless DEMO_DATA=true: openssl rand -base64 32
QR_SECRET=
# Bump to revoke every printed QR sticker of this branch at once
QR_STICKER_KEY_VERSION=1

# ------------------------------------------------------------------ hall QR code
# center — the join page on the center (visitors use mobile internet); local — the page on this node (branch Wi-Fi);
# auto — the center while the link is up, this node otherwise
QR_MODE=auto
QR_PUBLIC_BASE_URL=https://center.example.com
# Address of this node for phones in the hall; empty => the address the board was opened from
QR_LOCAL_BASE_URL=

# ------------------------------------------------------------------ host
NODE_PORT=8080
NODE_HEAP=1g
# Images: pulled from IMAGE_REGISTRY, or built locally with `up --build`
# IMAGE_REGISTRY=registry.example.com/esuo
# IMAGE_TAG=1.0.0

# ------------------------------------------------------------------ demo mode (never in production)
# DEMO_DATA seeds reference data and the operator/admin users; DEMO_MODE enables the accelerated demo clock and
# the demo-day reset used by scripts/demo
DEMO_DATA=false
DEMO_MODE=false
# DEMO_OPERATOR_PASSWORD=
# DEMO_ADMIN_PASSWORD=
