BRANCH_ID=b02
BRANCH_NAME=Отделение b02
# Адрес машины центра
CENTER_HOST=192.168.1.10
CENTER_LEAF_PORT=7422
# Логин leaf: обычно либо общий "leaf", индивидуальный "branch-b01"
LEAF_USER=leaf
LEAF_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
DEMO_DATA=true
# данные параметры включают демо режим, в к-м действуют: демо-часы(дают ускоренное течение времени) и сброс стенда — нужны для всех демо-сценариев
DEMO_MODE=true
DEMO_OPERATOR_PASSWORD=operator123
DEMO_ADMIN_PASSWORD=admin123
NODE_PORT=8082
# QR в зале. QR_MODE: center — страница входа на центре (интернет), local — на узле (Wi-Fi отделения),
# auto — центр, пока есть связь с ним, иначе узел. QR_PUBLIC_BASE_URL — публичный адрес центра (пусто — всегда узел);
# QR_LOCAL_BASE_URL — адрес узла для телефонов в зале (пусто — адрес, с которого открыто табло).
QR_MODE=auto
QR_PUBLIC_BASE_URL=http://192.168.1.10:8081
QR_LOCAL_BASE_URL=
# Ключ подписи QR (openssl rand -base64 32); обязателен при DEMO_DATA=false. Код на табло меняется каждые 2 мин.
QR_SECRET=
# Версия кода для наклеек: увеличить — все напечатанные наклейки перестанут действовать
QR_STICKER_KEY_VERSION=1
