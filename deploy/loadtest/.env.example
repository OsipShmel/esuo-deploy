# Load-test regions (deploy/loadtest/compose.yaml): regional NATS hubs that connect to the center's hub.
# Center address: another host — its name or IP; the center on this host as a separate project — host.docker.internal
HUB_HOST=center.example.com
HUB_LEAF_PORT=7422
# The center's shared leaf account (LEAF_PASSWORD in the center's .env)
LEAF_USER=leaf
LEAF_PASSWORD=
# swarm-sim heap: 2g for ~40 000 simulated branches, 4g for 250 000
SWARM_HEAP=2g
