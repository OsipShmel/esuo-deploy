# Local development environment (compose.yaml). cp .env.example .env, then fill in the secrets.
# scripts/ read this file too (shell syntax: no spaces around "=").

# ------------------------------------------------------------------ secrets (any values work locally)
DB_USER=esuo
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
LEAF_PASSWORD=
MP_WEBHOOK_SECRET=
# QR signing key (openssl rand -base64 32); empty => the static demo code demo:<branch> (DEMO_DATA=true only)
QR_SECRET=

# ------------------------------------------------------------------ center
CENTER_PUBLIC_URL=http://localhost:8081
NOTIFY_URL=http://notify-mock:8090/notify
MP_CALLBACK_URL=http://mp-simulator:8091/callback
# Network operator: login for /network and the private API
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=network123

# ------------------------------------------------------------------ branches
# Reference data and users operator / admin on both nodes, accelerated demo clock and demo-day reset
DEMO_DATA=true
DEMO_MODE=true
DEMO_OPERATOR_PASSWORD=operator123
DEMO_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------ observability (--profile monitoring)
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=true
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_DB_PASSWORD=grafana-ro-local
