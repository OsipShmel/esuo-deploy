DB_USER=esuo
DB_PASSWORD=
JWT_SECRET=
LEAF_PASSWORD=
MP_WEBHOOK_SECRET=
CENTER_PUBLIC_URL=http://localhost:8081
# Ключ подписи QR отделений (openssl rand -base64 32); пусто — демо-код demo:<b> (только при DEMO_DATA=true)
QR_SECRET=
DEMO_DATA=true
DEMO_MODE=true
DEMO_OPERATOR_PASSWORD=operator123
DEMO_ADMIN_PASSWORD=admin123
# Оператор сети: вход в /network и закрытый API центра; пусто — закрытый API недоступен никому
CENTER_ADMIN_LOGIN=network
CENTER_ADMIN_PASSWORD=network123
# Мониторинг (docker compose --profile monitoring up -d): Grafana на http://localhost:3000
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS=true
GRAFANA_PUBLIC_URL=http://localhost:3000
# Роль grafana_ro: Grafana читает метрики и аномалии центра, больше ничего; пусто — панели метрик без данных
GRAFANA_DB_PASSWORD=grafana-ro-local
# Центр под большой сетью (рой): куча JVM и история метрик отделений. По умолчанию — для ноутбука.
# CENTER_HEAP=2g                     # на сервере с роем — 4g
# METRICS_RESOLUTION_REGIONAL=60s    # точка метрик у отделений за региональным хабом (рой); 10s — подробные графики роя
# METRICS_MAX_SIZE=100GB             # страховка диска: сверх неё самые старые часы истории удаляются раньше 48 ч
# CENTER_DB_SHARED_BUFFERS=1GB       # память Postgres центра под таблицы сети; на сервере с роем — 25% ОЗУ
