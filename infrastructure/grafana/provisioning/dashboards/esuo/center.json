      {
        "name": "Перезапуск центра",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(process_start_time_seconds{job=\"center\"}[2m]) > 0",
        "step": "30s",
        "titleFormat": "центр перезапущен"
      }
    ]
  },
  "links": [
