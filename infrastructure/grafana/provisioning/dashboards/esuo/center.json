    {
      "id": 14,
      "type": "timeseries",
      "title": "Задачи по расписанию: самый долгий проход",
      "description": "Каждая задача центра: правила, сброс heartbeat, партиции, сверка конфигурации. Растущая задача — узкое место.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (code_namespace, code_function) (tasks_scheduled_execution_seconds_max{job=\"center\"}), \"task\", \"$1\", \"code_namespace\", \".*[.]([A-Za-z]+)\")",
          "legendFormat": "{{task}}.{{code_function}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Правила мониторинга",
      "description": "Один SQL-запрос по истории метрик раз в 15 с; дольше периода — в логе WARN.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(esuo_rules_pass_seconds_sum{job=\"center\"}[1m]) / rate(esuo_rules_pass_seconds_count{job=\"center\"}[1m])",
          "legendFormat": "проход, среднее, с",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "esuo_rules_pass_seconds_max{job=\"center\"}",
          "legendFormat": "проход, максимум, с",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "increase(esuo_rules_failures_total{job=\"center\"}[5m])",
          "legendFormat": "ошибок за 5 мин",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
