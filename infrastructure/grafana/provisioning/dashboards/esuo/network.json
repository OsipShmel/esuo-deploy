        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ошибок в логах за час",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({level=\"error\"}[1h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Отделения: последние метрики",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (m.branch_id) m.branch_id AS \"Отделение\", b.name AS \"Название\", (now() - b.last_heartbeat_at) < interval '30 seconds' AS \"На связи\", (m.sys->>'cpu_system')::float AS \"CPU\", (m.sys->>'heap_used_mb')::float AS \"Heap\", (m.sys->>'http_p95_ms')::float AS \"p95 API\", (m.sys->>'disk_free_mb')::float AS \"Диск свободно\", (m.queue->>'waiting')::int AS \"Ждут\", (m.queue->>'outbox_pending')::int AS \"Не отправлено\", (m.sys->>'app_version') AS \"Версия\", m.ts AS \"Данные на\" FROM branch_metrics m JOIN branches b ON b.id = m.branch_id WHERE m.ts > now() - interval '15 minutes' ORDER BY m.branch_id, m.ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет данных за 15 минут"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Отделение"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Дашборд отделения",
                    "url": "/d/esuo-branch?var-branch=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Heap"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 API"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Диск свободно"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Аномалии по правилам мониторинга",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT branch_id AS \"Отделение\", CASE severity WHEN 'critical' THEN 'критично' WHEN 'warning' THEN 'внимание' ELSE 'инфо' END AS \"Уровень\", text AS \"Что происходит\", since AS \"С\" FROM branch_alerts ORDER BY CASE severity WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END, since"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Аномалий нет"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU ПК по отделениям",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, branch_id AS metric, (sys->>'cpu_system')::float AS value FROM branch_metrics WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "insertNulls": 60000,
            "showPoints": "never",
            "max": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
