      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (branch) (count_over_time({level=\"error\"}[5m])))",
          "queryType": "range",
          "legendFormat": "{{branch}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "insertNulls": 60000,
            "showPoints": "never"
          }
        },
