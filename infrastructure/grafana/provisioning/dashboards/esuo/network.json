{
  "uid": "esuo-network",
  "title": "ЕСУО · Сеть",
  "description": "Все отделения: последние метрики, аномалии по правилам, ошибки в логах (design 6.5).",
  "tags": [
    "esuo",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Отделений на связи",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*) FILTER (WHERE last_heartbeat_at > now() - interval '30 seconds')::float AS v FROM branches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Отделений всего",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*)::float AS v FROM branches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Аномалий по правилам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*)::float AS v FROM branch_alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ошибок в логах за час",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({level=\"error\"}[1h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Отделения: свои и с аномалиями (до 200)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT b.id AS \"Отделение\", b.name AS \"Название\", (now() - b.last_heartbeat_at) < interval '30 seconds' AS \"На связи\", (b.last_heartbeat->'sys'->>'cpu_system')::float AS \"CPU\", (b.last_heartbeat->'sys'->>'heap_used_mb')::float AS \"Heap\", (b.last_heartbeat->'sys'->>'http_p95_ms')::float AS \"p95 API\", (b.last_heartbeat->'sys'->>'disk_free_mb')::float AS \"Диск свободно\", (b.last_heartbeat->>'waiting')::int AS \"Ждут\", (b.last_heartbeat->>'outbox_pending')::int AS \"Не отправлено\", b.last_heartbeat->'sys'->>'app_version' AS \"Версия\", a.texts AS \"Аномалии\", b.last_heartbeat_at AS \"Данные на\" FROM branches b LEFT JOIN (SELECT branch_id, string_agg(text, '; ' ORDER BY severity) AS texts, min(CASE severity WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END) AS sev FROM branch_alerts GROUP BY branch_id) a ON a.branch_id = b.id WHERE (b.last_heartbeat->>'events_via') IS NULL OR a.branch_id IS NOT NULL ORDER BY (b.last_heartbeat->>'events_via') IS NOT NULL, a.sev NULLS LAST, b.id LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет данных за 15 минут"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Отделение"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Дашборд отделения",
                    "url": "/d/esuo-branch?var-branch=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Heap"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 API"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Диск свободно"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "description": "Свои отделения (собственный leaf) — всегда; отделения роя и регионов — только с аномалиями по правилам. Последний heartbeat каждого."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Аномалии по правилам мониторинга (до 500)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT branch_id AS \"Отделение\", CASE severity WHEN 'critical' THEN 'критично' WHEN 'warning' THEN 'внимание' ELSE 'инфо' END AS \"Уровень\", text AS \"Что происходит\", since AS \"С\" FROM branch_alerts ORDER BY CASE severity WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END, since DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Аномалий нет"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU ПК: 10 самых загруженных отделений за 5 мин",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, branch_id AS metric, cpu_system AS value FROM branch_metrics WHERE $__timeFilter(ts) AND branch_id IN (SELECT branch_id FROM branch_metrics WHERE ts > now() - interval '5 minutes' AND cpu_system IS NOT NULL GROUP BY branch_id ORDER BY max(cpu_system) DESC LIMIT 10) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "insertNulls": 60000,
            "showPoints": "never",
            "max": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 API: 10 самых медленных отделений за 5 мин",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, branch_id AS metric, http_p95_ms AS value FROM branch_metrics WHERE $__timeFilter(ts) AND branch_id IN (SELECT branch_id FROM branch_metrics WHERE ts > now() - interval '5 minutes' AND http_p95_ms IS NOT NULL GROUP BY branch_id ORDER BY max(http_p95_ms) DESC LIMIT 10) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "insertNulls": 60000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ошибки в логах: 10 отделений с наибольшим числом (за 5 минут)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
