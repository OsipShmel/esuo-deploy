      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Аномалий по правилам",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "center-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "center-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*)::float AS v FROM branch_alerts"
        }
      ],
      "fieldConfig": {
